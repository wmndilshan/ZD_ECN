layout(local_size_x = 128) in;
layout(std430, binding=0) readonly buffer Lbs { float v_lbs[]; };
layout(std430, binding=1) readonly buffer Delta { float delta_mm[]; };
layout(std430, binding=2) writeonly buffer Out { float v_final[]; };
uniform int uApplyDelta;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 6890u) return;
    uint base = i * 3u;
    for (uint axis = 0u; axis < 3u; ++axis) {
        uint index = base + axis;
        float correction = uApplyDelta != 0 ? delta_mm[index] * 0.001 : 0.0;
        v_final[index] = v_lbs[index] + correction;
    }
}
