<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0C10">

    <!-- GL Surface fills most of the screen -->
    <com.graphicsresearch.skinrenderer.SkinRenderSurfaceView
        android:id="@+id/gl_surface_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Control panel (scrollable for small screens) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1C22"
        android:maxHeight="280dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Row 1: Backend + Texture -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Backend selector -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Backend"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"/>
                    <RadioGroup
                        android:id="@+id/rg_backend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rb_zdecn"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ZD-ECN" android:textColor="#CCDDEE"
                            android:textSize="12sp" android:checked="true"/>
                        <RadioButton android:id="@+id/rb_onnx_cpu"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ONNX CPU" android:textColor="#CCDDEE" android:textSize="12sp"/>
                        <RadioButton android:id="@+id/rb_lbs_only"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="LBS only" android:textColor="#CCDDEE" android:textSize="12sp"/>
                    </RadioGroup>
                </LinearLayout>

                <!-- Texture selector -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Texture"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"/>
                    <RadioGroup
                        android:id="@+id/rg_texture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rb_tex0"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Procedural" android:textColor="#CCDDEE"
                            android:textSize="12sp" android:checked="true"/>
                        <RadioButton android:id="@+id/rb_tex1"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Meshcapade" android:textColor="#CCDDEE" android:textSize="12sp"/>
                        <RadioButton android:id="@+id/rb_tex_none"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Debug grey" android:textColor="#CCDDEE" android:textSize="12sp"/>
                    </RadioGroup>
                </LinearLayout>

                <!-- Pose tier selector -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pose tier"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"/>
                    <RadioGroup
                        android:id="@+id/rg_tier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton android:id="@+id/rb_natural"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Natural" android:textColor="#CCDDEE"
                            android:textSize="12sp" android:checked="true"/>
                        <RadioButton android:id="@+id/rb_moderate"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Moderate" android:textColor="#CCDDEE" android:textSize="12sp"/>
                        <RadioButton android:id="@+id/rb_extreme"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Extreme" android:textColor="#CCDDEE" android:textSize="12sp"/>
                    </RadioGroup>
                </LinearLayout>

            </LinearLayout>

            <!-- Separator -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#333344" android:layout_marginVertical="6dp"/>

            <!-- Lighting controls -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Wrap (SSS): 0.3" android:textColor="#AAAAAA"
                android:id="@+id/lbl_wrap" android:textSize="11sp"/>
            <SeekBar android:id="@+id/seek_wrap"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Specular: 0.05" android:textColor="#AAAAAA"
                android:id="@+id/lbl_spec" android:textSize="11sp"/>
            <SeekBar android:id="@+id/seek_spec"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Light angle: 0°" android:textColor="#AAAAAA"
                android:id="@+id/lbl_light" android:textSize="11sp"/>
            <SeekBar android:id="@+id/seek_light_angle"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <!-- Status row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/tv_fps"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ZD-ECN: -- ms"
                    android:textColor="#88AACC" android:textSize="11sp"/>
                <Button android:id="@+id/btn_benchmark"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="Benchmark"
                    android:textSize="11sp" android:padding="4dp"/>
                <Button android:id="@+id/btn_screenshot"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:text="Screenshot"
                    android:textSize="11sp" android:padding="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
