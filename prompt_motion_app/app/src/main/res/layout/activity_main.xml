<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0C10">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.graphicsresearch.promptmotion.MotionSurfaceView
            android:id="@+id/gl_surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#66000000">
            <TextView android:id="@+id/tv_fps"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FPS: --" android:textColor="#88CCFF" android:textSize="12sp"
                android:fontFamily="monospace"/>
            <TextView android:id="@+id/tv_phase"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFF" android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/progress"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"/>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161920">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Prompt row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText android:id="@+id/et_prompt"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Describe a motion… e.g. walk forward, turn left, jump"
                    android:textColorHint="#667080" android:textColor="#E8ECF2"
                    android:textSize="14sp" android:maxLines="3"
                    android:inputType="textMultiLine|textCapSentences"
                    android:imeOptions="actionDone"
                    android:background="#232733" android:padding="10dp"/>
                <Button android:id="@+id/btn_generate"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Animate" android:textSize="13sp"/>
            </LinearLayout>

            <!-- Presets -->
            <HorizontalScrollView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none" android:layout_marginTop="4dp">
                <LinearLayout android:id="@+id/preset_row"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>

            <!-- Playback row -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                <Button android:id="@+id/btn_play"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:text="Pause" android:textSize="12sp"/>
                <SeekBar android:id="@+id/seek_time"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView android:id="@+id/tv_time"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0.0 / 0.0 s" android:textColor="#AAB4C0" android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Options row -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <Switch android:id="@+id/sw_llm"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="OpenAI planner " android:textColor="#CCDDEE" android:textSize="12sp"
                    android:checked="true"/>
                <Spinner android:id="@+id/sp_speed"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
                <Spinner android:id="@+id/sp_texture"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <RadioGroup android:id="@+id/rg_backend"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rb_zdecn"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ZD-ECN GPU" android:textColor="#CCDDEE" android:textSize="12sp"
                    android:checked="true"/>
                <RadioButton android:id="@+id/rb_onnx_cpu"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ONNX CPU" android:textColor="#CCDDEE" android:textSize="12sp"/>
                <RadioButton android:id="@+id/rb_lbs_only"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LBS only" android:textColor="#CCDDEE" android:textSize="12sp"/>
            </RadioGroup>

            <TextView android:id="@+id/tv_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#9AA6B4" android:textSize="11sp"
                android:fontFamily="monospace" android:layout_marginTop="2dp"/>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="end">
                <Button android:id="@+id/btn_benchmark"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:text="Benchmark" android:textSize="11sp"/>
                <Button android:id="@+id/btn_screenshot"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:text="Screenshot" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
