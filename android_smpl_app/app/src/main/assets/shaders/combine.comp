#version 310 es
layout(local_size_x = 128) in;
layout(std430, binding=0) readonly buffer Lbs { vec4 v_lbs[]; };
layout(std430, binding=1) readonly buffer Delta { vec4 delta_mm[]; };
layout(std430, binding=2) writeonly buffer Out { vec4 v_final[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 6890u) return;
    v_final[i] = vec4(v_lbs[i].xyz + delta_mm[i].xyz * 0.001, 1.0);
}
